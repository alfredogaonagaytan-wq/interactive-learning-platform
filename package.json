{
  "name": "interactive-learning-platform",
  "private": true,
  "version": "0.6.0",
  "description": "Open-source, local-first interactive learning activities for classrooms (H5P-style), with Google Drive submissions.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ilp/web",
    "build": "npm run build -w @ilp/web",
    "preview": "npm run preview -w @ilp/web",
    "typecheck": "node services/submission-broker/build.mjs && tsc -p packages/core && tsc -p apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test",
    "build:broker": "node services/submission-broker/build.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^27.0.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.0",
    "vite": "^7.3.7",
    "@vitejs/plugin-react": "^5.2.0"
  },
  "overrides": {
    "vite": "$vite"
  }
}
